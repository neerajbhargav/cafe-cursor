# Optional. Local `npm run dev` saves cards to `.data/contacts.json`.
# On Vercel, add one of these so everyone in the room sees the same wall.

# Vercel KV / Upstash Redis (Storage > Create KV Database)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# or Upstash Redis REST
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# or Vercel Blob (Storage > Create Blob Store)
# BLOB_READ_WRITE_TOKEN=

# Public URL for Open Graph (set after first deploy)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
